cabal-version: 3.8
name: base
version: 4.21.0.0
build-type: Simple
license: Unlicense
license-file: LICENSE
synopsis: The aihc-boot base library
description:
  A small replacement for GHC's base. It has only the names that the
  vendored tree uses, and it grows on demand. The modules and names
  follow GHC's base, so the vendored tree also builds with GHC.
  .
  GHC does not build this package: GHC uses its own base.

library
  default-language: Haskell2010
  default-extensions: NoImplicitPrelude

  exposed-modules:
    Control.Applicative
    Control.Exception
    Control.Monad
    Control.Monad.Fail
    Control.Monad.Fix
    Control.Monad.IO.Class
    Control.Monad.ST
    Control.Monad.ST.Unsafe
    Data.Bifunctor
    Data.Bits
    Data.Bool
    Data.Char
    Data.Data
    Data.Dynamic
    Data.Either
    Data.Eq
    Data.Foldable
    Data.Function
    Data.Functor
    Data.Functor.Const
    Data.Functor.Identity
    Data.Int
    Data.Kind
    Data.List
    Data.List.NonEmpty
    Data.Maybe
    Data.Monoid
    Data.Ord
    Data.Proxy
    Data.Semigroup
    Data.String
    Data.Traversable
    Data.Tuple
    Data.Typeable
    Data.Typeable.Internal
    Data.Void
    Data.Word
    Foreign
    Foreign.C.Types
    Foreign.ForeignPtr
    Foreign.ForeignPtr.Unsafe
    Foreign.Marshal.Alloc
    Foreign.Marshal.Utils
    Foreign.Ptr
    Foreign.Storable
    GHC.Base
    GHC.Bits
    GHC.Classes
    GHC.Enum
    GHC.Err
    GHC.Exception
    GHC.Exception.Type
    GHC.Exts
    GHC.ForeignPtr
    GHC.Generics
    GHC.Int
    GHC.IsList
    GHC.List
    GHC.Maybe
    GHC.Num
    GHC.Num.Integer
    GHC.Prim
    GHC.Ptr
    GHC.Real
    GHC.ST
    GHC.Show
    GHC.Stack.Types
    GHC.Types
    GHC.Word
    Numeric.Natural
    Prelude
    System.IO
    System.IO.Unsafe
    Text.Show

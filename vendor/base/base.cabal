cabal-version: 3.8
name: base
version: 4.21.0.0
build-type: Simple
license: Unlicense
license-file: LICENSE
synopsis: The aihc-boot base library
description:
  A small replacement for GHC's base. It has only the names that the
  vendored tree uses, and it grows on demand. The modules and names
  follow GHC's base, so the vendored tree also builds with GHC.
  .
  GHC does not build this package: GHC uses its own base.

library
  default-language: Haskell2010
  default-extensions: NoImplicitPrelude

  exposed-modules:
    Control.Exception
    Control.Monad
    Data.Char
    Data.Either
    Data.Foldable
    Data.Functor
    Data.List
    Data.Maybe
    Data.String
    Data.Traversable
    Data.Tuple
    Data.Typeable
    Data.Typeable.Internal
    GHC.Base
    GHC.Classes
    GHC.Enum
    GHC.Err
    GHC.Exception
    GHC.Exception.Type
    GHC.Generics
    GHC.List
    GHC.Maybe
    GHC.Num
    GHC.Num.Integer
    GHC.Prim
    GHC.Real
    GHC.Show
    GHC.Types
    Prelude
    System.IO

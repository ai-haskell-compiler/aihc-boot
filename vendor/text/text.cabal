cabal-version:  2.2
name:           text
version:        2.1.3

homepage:       https://github.com/haskell/text
bug-reports:    https://github.com/haskell/text/issues
synopsis:       An efficient packed Unicode text type.
description:
    Cut down for aihc-boot: the 'Text' type, its basic instances and
    'Data.Text.Encoding.decodeUtf8With'. The package uses the Haskell code
    of the upstream @pure-haskell@ flag and has no C or C++ sources.

license:        BSD-2-Clause
license-file:   LICENSE
author:         Bryan O'Sullivan <bos@serpentine.com>
maintainer:     Haskell Text Team <andrew.lelechenko@gmail.com>, Core Libraries Committee
copyright:      2009-2011 Bryan O'Sullivan, 2008-2009 Tom Harper, 2021 Andrew Lelechenko
category:       Data, Text
build-type:     Simple

library
  hs-source-dirs: src

  exposed-modules:
    Data.Text
    Data.Text.Array
    Data.Text.Encoding
    Data.Text.Encoding.Error
    Data.Text.Internal
    Data.Text.Internal.ByteStringCompat
    Data.Text.Internal.Encoding
    Data.Text.Internal.Encoding.Utf8
    Data.Text.Internal.StrictBuilder
    Data.Text.Internal.Unsafe
    Data.Text.Internal.Unsafe.Char
    Data.Text.Unsafe

  other-modules:
    Data.Text.Internal.IsAscii
    Data.Text.Show

  build-depends:
    base       >= 4.11 && < 5,
    bytestring >= 0.10.4 && < 0.13,
    deepseq    >= 1.1 && < 1.6,
    ghc-prim   >= 0.2 && < 0.14

  ghc-options: -Wall -fwarn-tabs -funbox-strict-fields -O2
  default-language: Haskell2010
  default-extensions:
    NondecreasingIndentation

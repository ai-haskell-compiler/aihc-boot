f = \ a1 a2 ->
    let {
      f{2} = case a2 of {
          (:) x xs -> let {
              unused = a1;
            } in
            let {
              guard{2} = case GHC.Base.otherwise of {
                  True -> f (GHC.Num.(-) a1 1) xs;
                  _ -> next;
                };
            } in
            case GHC.Classes.(>) x a1 of {
              True -> x;
              _ -> next;
            };
          _ -> next;
        };
      f{3} = 0;
    } in
    case a1 of {
      0 -> case a2 of {
          [] -> 1;
          _ -> next;
        };
      _ -> next;
    }
g = \ m ->
    let {
      scrut = m;
    } in
    let {
      alt{2} = case scrut of {
          Just _ -> case _ of {
              (,) a _ -> GHC.Num.(+) a 1;
            };
          _ -> next;
        };
      alt{3} = case scrut of {
          Nothing -> 0;
          _ -> GHC.Prim.error "case: no alternative matched";
        };
    } in
    case scrut of {
      Just _ -> case _ of {
          (,) a b -> case GHC.Classes.(==) a b of {
              True -> a;
              _ -> next;
            };
        };
      _ -> next;
    }
main = GHC.Base.(>>) (System.IO.print (f 3 ((:) 1 ((:) 2 ((:) 3 []))))) (GHC.Base.(>>=) System.IO.getLine (\ x ->
        let {
          n = GHC.List.length x;
        } in
        System.IO.print (g (Just ((,) n n)))))

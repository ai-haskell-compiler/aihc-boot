main = let {
    h = let {
        pat{0} = (,) 1 2;
        a = case pat of {
            (,) a b -> a;
          };
        b = case pat of {
            (,) a b -> b;
          };
        k = \ z ->
            GHC.Num.(+) (GHC.Num.(+) a b) z;
      } in
      k;
  } in
  System.IO.print (GHC.Num.(+) (GHC.List.sum (GHC.List.concatMap (\ x ->
            let {
              y = GHC.Num.(*) x x;
            } in
            case GHC.Real.odd y of {
              True -> (:) y [];
              _ -> [];
            }) (GHC.Enum.enumFromTo 1 10))) (h 3))
